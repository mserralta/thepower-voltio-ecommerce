{
  "name": "tienda-online-exercice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "postinstall": "node node_modules/prisma/build/index.js generate",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "seed": "node node_modules/prisma/build/index.js db seed",
    "test": "node node_modules/vitest/vitest.mjs run",
    "db:check": "node node_modules/tsx/dist/cli.mjs scripts/db-check.ts",
    "stripe:check": "node node_modules/tsx/dist/cli.mjs scripts/stripe-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "15.5.27",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/env": "15.5.27",
    "@tailwindcss/postcss": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
